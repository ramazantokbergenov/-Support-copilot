# Local FastAPI. Use an operator account only on trusted local development.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Supabase Edge mode: remove VITE_API_BASE_URL or set it to
# https://<project-ref>.supabase.co/functions/v1/api
# The anon key is public; never put service_role or LLM secrets here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=